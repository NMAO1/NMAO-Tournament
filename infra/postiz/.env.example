# Copy to .env and fill in. Never commit the real .env.
# --- Public host ---
POSTIZ_HOST=postiz.nmao.us
POSTIZ_MAIN_URL=https://postiz.nmao.us

# --- Secrets (generate strong random values) ---
# JWT:  openssl rand -hex 32
POSTIZ_JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
# DB password: openssl rand -hex 16
POSTIZ_DB_PASSWORD=CHANGE_ME_db_password

# Lock signups after you create your owner login (set true, then `docker compose up -d`)
POSTIZ_DISABLE_REGISTRATION=false

# --- Social provider app keys (add as you create each developer app) ---
# FACEBOOK_ID=
# FACEBOOK_SECRET=
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
# TIKTOK_CLIENT_ID=
# TIKTOK_CLIENT_SECRET=
