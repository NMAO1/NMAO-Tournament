{
  "expo": {
    "name": "NMAO Compete",
    "slug": "nmao-compete",
    "scheme": "nmao-compete",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "us.nmao.compete",
      "associatedDomains": ["applinks:compete.nmao.us"]
    },
    "android": {
      "package": "us.nmao.compete",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "compete.nmao.us", "pathPrefix": "/invite" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "NMAO needs access to your videos so you can submit your competition entry."
        }
      ],
      "expo-audio",
      "expo-web-browser",
      "expo-video"
    ]
  }
}
